# Copy to .env for local runs, or paste these into Render -> Environment.
# .env is gitignored. Never commit real values.

# --- Upstox ---------------------------------------------------------------
# Required at runtime. Check its lifetime with: python check_token.py
UPSTOX_ACCESS_TOKEN=

# Only needed to mint a new token via get_token.py.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# --- Data provider --------------------------------------------------------
DATA_PROVIDER=upstox        # upstox | nse
UPSTOX_FALLBACK=1           # 1 = fall back to NSE/yfinance if Upstox is unavailable
UPSTOX_HISTORY=0            # 1 = daily candles from Upstox instead of yfinance
UPSTOX_QUOTE_BATCH=100      # instrument keys per quote request
UPSTOX_TOKEN_WARN_DAYS=7    # start warning in logs this long before expiry

# --- Volume gate ----------------------------------------------------------
VOL_MULTIPLIER=1.5          # Volume must exceed this multiple of the 20-day average
LIVE_VOL_MODE=project       # project | raw | off
MIN_SESSION_FRACTION=0.08   # suppress the intraday projection for the first ~30 min
